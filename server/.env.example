NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the app, so the rate limiters see the
# real client IP. Leave at 0 locally; set to 1 on hosts like Render/Railway/Fly.
TRUST_PROXY=0
MONGO_URI=mongodb://localhost:27017/mern-keyboard-marketplace
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
STRIPE_SECRET_KEY=your_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
